<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Family-invite Universal Link: https://housemira.com/invite/<code>
	     handled in-app by the `/invite/:code` route (see AppRoutes).
	     Must stay in sync with the backend invite flow
	     (EdgetFunctions.sendEmail) and the Android App Link. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:housemira.com</string>
	</array>
	<!-- Sign in with Apple (native Apple ID authentication).
	     The capability must also be enabled on the App ID
	     (com.housemira.app) in the Apple Developer portal, otherwise the
	     native sheet fails without any visible error. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
