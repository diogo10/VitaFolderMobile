{
    // Run practices (AGENTS.md + README "Environments & secrets"):
    // - Always run via FVM (see ../.vscode/settings.json -> dart.flutterSdkPath).
    // - Backend credentials come from --dart-define-from-file=env/<flavor>.json
    //   (AppConfig.fromEnvironment throws StateError without them), so every
    //   config below passes toolArgs with its flavor file. Copy
    //   env/<flavor>.example.json to env/<flavor>.json and fill it in first.
    // - No device is pinned: pick the target from the VS Code status bar.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "HouseMira (dev)",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define-from-file=env/dev.json"
            ]
        },
        {
            "name": "HouseMira (staging)",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "debug",
            "toolArgs": [
                "--dart-define-from-file=env/staging.json"
            ]
        },
        {
            "name": "HouseMira (dev, profile)",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=env/dev.json"
            ]
        },
        {
            "name": "HouseMira (prod, release)",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=env/prod.json"
            ]
        }
    ]
}
