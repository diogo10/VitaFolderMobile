    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug"
        },
        {
            "name": "Flutter (web)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "-d",
                "chrome"
            ]
        },
        {
            "name": "Flutter (web-server)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "-d",
                "web-server",
                "--web-hostname",
                "0.0.0.0",
                "--web-port",
                "3000"
            ]
        },
        {
            "name": "Flutter (Android)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "-d",
                "android"
            ]
        },
        {
            "name": "Flutter (iOS)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "-d",
                "ios"
            ]
        },
        {
            "name": "VitaFolderMobile",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "VitaFolderMobile (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "VitaFolderMobile (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}